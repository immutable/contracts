{
  "name": "@imtbl/contracts",
  "version": "3.0.0",
  "description": "Immutable Smart Contracts",
  "author": "Immutable",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/immutable/contracts.git"
  },
  "homepage": "https://github.com/immutable/contracts",
  "bugs": {
    "url": "https://github.com/immutable/contracts/issues"
  },
  "files": [
    "dist",
    "contracts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts/*": "./contracts/*"
  },
  "scripts": {
    "build": "tsup",
    "compile": "forge build",
    "test": "forge test",
    "test:coverage": "forge coverage",
    "format": "forge fmt",
    "format:check": "forge fmt --check",
    "lint": "solhint 'contracts/**/*.sol'",
    "clean": "rimraf dist foundry-out cache artifacts broadcast"
  },
  "peerDependencies": {
    "@openzeppelin/contracts": "^4.9.3 || ^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "solhint": "^5.0.1",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "blockchain",
    "contracts",
    "ethereum",
    "immutable",
    "solidity"
  ]
}